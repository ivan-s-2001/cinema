+static struct mp_chmap select_channel_map(const AudioChannelLayout *layout,
+                                          UInt32 size, bool prefer_stereo)
+{
+    struct mp_chmap stereo = MP_CHMAP_INIT_STEREO;
+    size_t header_size = offsetof(AudioChannelLayout, mChannelDescriptions);
+    if (prefer_stereo || !layout || size < header_size ||
+        layout->mNumberChannelDescriptions == 0 ||
+        layout->mNumberChannelDescriptions > MP_NUM_CHANNELS ||
+        layout->mNumberChannelDescriptions >
+            (size - header_size) / sizeof(AudioChannelDescription))
+        return stereo;
+
+    struct mp_chmap channels = {.num = layout->mNumberChannelDescriptions};
+    for (int n = 0; n < channels.num; n++) {
+        int speaker = ca_label_to_mp_speaker_id(layout->mChannelDescriptions[n].mChannelLabel);
+        if (speaker < 0 || speaker >= MP_SPEAKER_ID_NA)
+            return stereo;
+        channels.speaker[n] = speaker;
+    }
+
+    return mp_chmap_is_valid(&channels) ? channels : stereo;
+}
