# Copy to the protected server environment file and replace both values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cinemahall
DB_USER=cinemahall
DB_PASSWORD=replace-with-a-long-random-database-password

# Used to sign short-lived account access tokens. Keep secret and at least 32 bytes.
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional public key sent by the Android client in the apikey header.
# If configured here, enter the same value in the app's custom backend settings.
CINEMA_PUBLISHABLE_KEY=replace-with-public-client-key
